{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/leaderboard", "destination": "/index.html" },
    { "source": "/harnesses/:slug", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "build-wheel.vercel.app" }],
      "destination": "https://buildwheel.snackoverflowgeorge.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "build-wheel.vercel.app" }],
      "destination": "https://buildwheel.snackoverflowgeorge.com/:path*",
      "permanent": true
    }
  ]
}
